# Environment variables for the AiriWheels demand-forecast service.
#
# Copy this file to `.env` for local use, or set each of these on Maritime
# via `maritime env set <agent> KEY=value` (see DEPLOY.md section 3) —
# never commit a filled-in `.env` or real values into this file.
#
# All values below are placeholders/dummies. No real secrets belong here.

# --- Maritime platform auth (used by the deploy CLI itself, not by the app at runtime) ---
# Long-lived Maritime API token for authenticating CLI/fleet operations non-interactively.
# DEPLOY.md section 1 / https://maritime.sh/docs/fleet
MARITIME_TOKEN=mk_dummy_replace_me

# --- Multi-tenant identity (DEPLOY.md section 7) ---
# Which restaurant this agent instance serves. One Maritime agent per
# restaurant; each instance's LOCATION must be unique and match the
# `location` values in its own sales/actuals data.
LOCATION=demo_location

# --- Sales connector (PRD.md section 6.1, section 9) ---
# Only needed once a real POS connector (Toast or Square) replaces the
# synthetic-data path used by `app/service/pipeline.py` today.
POS_PROVIDER=toast
POS_API_KEY=dummy_pos_key
POS_LOCATION_ID=dummy_location_id

# --- Signal providers (PRD.md section 9) ---
# Weather: Open-Meteo needs no key for dev/non-commercial use; Visual
# Crossing (commercial-safe) requires a key.
VISUAL_CROSSING_API_KEY=dummy_weather_key

# Events: Ticketmaster Discovery API (v1 provider).
TICKETMASTER_API_KEY=dummy_events_key

# Holidays: Nager.Date is free/unlimited and needs no key — no var required.

# --- Service config ---
# Port the FastAPI/uvicorn service listens on. Matches Dockerfile's EXPOSE
# and Maritime's documented --port default (https://maritime.sh/docs/cli).
PORT=8080
